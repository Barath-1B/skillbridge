PORT=5001
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/skillbridge?retryWrites=true&w=majority
JWT_SECRET=<strong-random-secret-min-32-chars>
JWT_EXPIRES_IN=1h
REFRESH_EXPIRES_IN=30d
NODE_ENV=production
CLIENT_URL=https://<your-app>.vercel.app
LOG_LEVEL=info

# MongoDB MCP Server — Claude Code direct DB access
# Set MDB_MCP_CONNECTION_STRING in .mcp.json (gitignored), not here
# MDB_MCP_CONNECTION_STRING=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/skillbridge
